# Copie para .env. O compose injeta este arquivo no container da API (`env_file: .env`).
# Todas as chaves fazem override do config.json (ponto vira underscore):
#   auth.pepper → AUTH_PEPPER, auth.jwt_secret → AUTH_JWT_SECRET, database.url → DATABASE_URL.
PORT=8080
DATABASE_URL=postgres://agrobench:agrobench@db:5432/agrobench?sslmode=disable
AUTH_PEPPER=change-me-32-bytes-minimum-please-really
AUTH_JWT_SECRET=change-me-32-bytes-minimum-please-really
ADMIN_EMAIL=admin@agrobench.local
ADMIN_PASSWORD=admin123

# Enclave MOCK (ativo no pitch). Chaves fixas de dev — se vazias, são geradas a cada boot
# e todo payload cifrado antes do restart deixa de ser decifrável. Gere novas com:
#   go run ./cmd keygen   (fase 4)  ou  openssl rand -hex 32
ENCLAVE_MOCK_BOX_PRIVATE_KEY=6a62607d2a7ea729be08bf34d0e907d027a878d606adbd61da69106ad1b9a94f
ENCLAVE_MOCK_SIGNING_PRIVATE_SEED=b6b0c988ec611f2b8d795d0f6f6140324a669a59a2e2356923188720dfa3406b

# ---------------------------------------------------------------------------
# Adapters REAIS (não usados no pitch). Preencha só se trocar `adapters.*`
# no config.dev.json de mock para solana | nitro | stripe | http | conab | twilio.
# Segredos nunca vão no json — só aqui.
# ---------------------------------------------------------------------------

# Solana devnet (adapters.chain=solana)
CHAIN_SOLANA_RPC_URL=https://api.devnet.solana.com
CHAIN_SOLANA_TREASURY_PRIVATE_KEY=
CHAIN_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
CHAIN_SOLANA_POOL_PUBKEY=
CHAIN_SOLANA_CONFIRM_TIMEOUT_SECONDS=60

# Nitro Enclave host (adapters.enclave=nitro)
# CID vem de `nitro-cli describe-enclaves` (EnclaveCID). PCRs, do EIF medido.
ENCLAVE_NITRO_CID=16
ENCLAVE_NITRO_PORT=5000
ENCLAVE_NITRO_ROOT_CERT_PATH=config/aws_nitro_root.pem
ENCLAVE_NITRO_TIMEOUT_SECONDS=30

# Stripe test mode (adapters.payment=stripe)
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=
PAYMENT_STRIPE_SUCCESS_URL=http://localhost:8080/payment/success?session_id={CHECKOUT_SESSION_ID}
PAYMENT_STRIPE_CANCEL_URL=http://localhost:8080/payment/cancel
PAYMENT_STRIPE_CURRENCY=usd
PAYMENT_STRIPE_FIAT_PER_USDC=1

# Twilio (adapters.sms=twilio)
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
SMS_TWILIO_TIMEOUT_SECONDS=10

# SICAR HTTP (adapters.sicar=http) — TODO(sicar): endpoint público não confirmado (README §14)
SICAR_HTTP_BASE_URL=
SICAR_HTTP_PATH_TEMPLATE=/api/v1/imoveis/%s
SICAR_HTTP_API_KEY=
SICAR_HTTP_TIMEOUT_SECONDS=10

# CONAB HTTP (adapters.reference_data=conab) — TODO(conab): endpoint público não confirmado (README §14)
REFERENCE_DATA_CONAB_BASE_URL=
REFERENCE_DATA_CONAB_PATH_TEMPLATE=/api/v1/custos?cultura=%s&microrregiao=%s
REFERENCE_DATA_CONAB_TOLERANCE_PCT=40
REFERENCE_DATA_CONAB_TIMEOUT_SECONDS=10
