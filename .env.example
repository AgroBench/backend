# Copie para .env. Todas as chaves fazem override do config.json (ponto vira underscore).
PORT=8080
DATABASE_URL=postgres://agrobench:agrobench@db:5432/agrobench?sslmode=disable
AUTH_PEPPER=change-me-32-bytes-minimum-please-really
AUTH_JWT_SECRET=change-me-32-bytes-minimum-please-really
ADMIN_EMAIL=admin@agrobench.local
ADMIN_PASSWORD=admin123

# Enclave MOCK (ativo no pitch). Chaves fixas de dev — se vazias, são geradas a cada boot
# e todo payload cifrado antes do restart deixa de ser decifrável. Gere novas com:
#   go run ./cmd keygen   (fase 4)  ou  openssl rand -hex 32
ENCLAVE_MOCK_BOX_PRIVATE_KEY=6a62607d2a7ea729be08bf34d0e907d027a878d606adbd61da69106ad1b9a94f
ENCLAVE_MOCK_SIGNING_PRIVATE_SEED=b6b0c988ec611f2b8d795d0f6f6140324a669a59a2e2356923188720dfa3406b

# Adapters REAIS (não usados no pitch) — preencha só se trocar `adapters.*` no config
CHAIN_SOLANA_TREASURY_PRIVATE_KEY=
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
PAYMENT_STRIPE_SECRET_KEY=
PAYMENT_STRIPE_WEBHOOK_SECRET=
PAYMENT_STRIPE_SUCCESS_URL=
PAYMENT_STRIPE_CANCEL_URL=
SICAR_HTTP_BASE_URL=
REFERENCE_DATA_CONAB_BASE_URL=
